# انسخ هذا الملف إلى .env وعدّل القيم محليًا. لا تضع أسرارًا حقيقية في .env.example.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://qeedha_dev:qeedha_dev_pw@localhost:5432/qeedha_accounting?schema=public"

# اتصال منفصل، دور Postgres مختلف وأضيق صلاحية (BYPASSRLS + SELECT محدود على
# memberships/companies) يُستخدم حصرًا لحل "ما المنشآت التي يملك المستخدم
# عضوية فيها؟" أثناء تسجيل الدخول قبل معرفة الـtenant المُختار. أنشئه عبر
# prisma/manual-sql/001_auth_lookup_role.sql ثم 002_auth_lookup_role_update.sql.
# راجع docs/SECURITY.md قسم "Auth bootstrap" للتفاصيل.
AUTH_LOOKUP_DATABASE_URL="postgresql://qeedha_auth_lookup:qeedha_auth_lookup_pw@localhost:5432/qeedha_accounting?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"

# رمز قصير الأجل ومستقل يُصدر بين التحقق من كلمة المرور واختيار المنشأة،
# فقط للمستخدم الذي لديه أكثر من Membership. سرّ منفصل عمدًا عن الوصول
# الفعلي حتى لا يخلط أي Guard مستقبلي بينهما. راجع AuthService.
JWT_TENANT_SELECTION_SECRET="change-me-tenant-selection-secret"
JWT_TENANT_SELECTION_TTL="10m"

# اتصال منفصل ثالث، دور Postgres آخر ضيق (BYPASSRLS + SELECT محدود على
# companies فقط)، مستقل تمامًا عن qeedha_auth_lookup - يُستخدم حصرًا من
# PlatformAdminService لعرض المنشآت عبر كل الـtenants للوحة تحكم SaaS.
# أنشئه عبر prisma/manual-sql/004_platform_admin_role.sql.
PLATFORM_ADMIN_DATABASE_URL="postgresql://qeedha_platform_admin:qeedha_platform_admin_pw@localhost:5432/qeedha_accounting?schema=public"

# سرّ JWT مستقل تمامًا عن JWT_ACCESS_SECRET - جلسة مدير النظام (PlatformAdmin)
# ليست Membership ولا يجب أن تُقبَل أبدًا في أي Guard تابع لجلسة تاجر عادية،
# والعكس. راجع PlatformAdminAuthGuard.
JWT_PLATFORM_ADMIN_SECRET="change-me-platform-admin-secret"
JWT_PLATFORM_ADMIN_TTL="8h"

# مفتاح تشفير بيانات اعتماد التكاملات (integration_connections.credentials_encrypted)
# يجب أن يكون 32 بايت (256-bit) مُرمّز Base64 في الإنتاج. لا تستخدم القيمة الافتراضية إنتاجيًا.
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY="change-me-32-byte-base64-encryption-key=="

# قائمة origins مسموح بها لـCORS، مفصولة بفواصل - بلا مسافات زائدة أو "*"
# إطلاقًا (راجع src/config/cors.config.ts وdocs/SECURITY.md "CORS").
# اختياري في development/test (افتراضي: منافذ Vite المحلية). **إلزامي في
# production** - التطبيق يرفض البدء بدونه هناك (fail-closed، وليس فتح
# CORS بصمت). مثال Demo/Staging:
# CORS_ALLOWED_ORIGINS="https://demo.qeedha-b.example.com,https://staging.qeedha-b.example.com"
CORS_ALLOWED_ORIGINS=""

# مزوّد تخزين الملفات لاستيراد Excel (Milestone 3) - "local" فقط مدعوم
# حاليًا (راجع src/modules/storage). اختياري، الافتراضي "local".
STORAGE_DRIVER="local"

# المجلد المحلي الذي يُخزَّن فيه ملفات الاستيراد المرفوعة عبر مزوّد
# "local" - لا يُخدَّم كملفات ثابتة أبدًا وليس داخل بناء الواجهة الأمامية.
# اختياري، الافتراضي "./storage-data".
STORAGE_LOCAL_DIR="./storage-data"

# Website phase: email provider driver - only "console" (logs the email
# instead of sending it) is implemented; see backend/src/modules/email.
# Optional, defaults to "console".
EMAIL_DRIVER="console"

# Website phase: public frontend origin used to build links inside
# transactional emails (e.g. email verification). Optional, defaults to
# the local Vite dev server origin.
WEBSITE_BASE_URL="http://localhost:5173"
