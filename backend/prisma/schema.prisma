// Qeedha Accounting - Prisma Schema
// Phase 1: Tenancy, IAM/RBAC, Auth, Audit Log, Integration Layer skeleton.
// Additional modules (catalog, inventory, sales, accounting, ...) are added
// in later phases per /docs/ROADMAP.md - not defined here yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum CompanyStatus {
  active
  suspended
}

model Company {
  id                 String        @id @default(uuid()) @db.Uuid
  legalName          String        @map("legal_name")
  tradeName          String?       @map("trade_name")
  vatNumber          String?       @map("vat_number")
  crNumber           String?       @map("cr_number")
  defaultCurrency    String        @default("SAR") @map("default_currency")
  // Market the company registered under (Website phase) - free-text ISO
  // country code, not an FK to Market.code, so a company keeps its history
  // even if a market is later deactivated/removed. See Market model below.
  countryCode        String        @default("SA") @map("country_code")
  // Phase 12: human-dictatable tenant identifier ("رقم الاشتراك") -
  // sequential, distinct from the internal uuid `id`. Assigned by the DB
  // sequence at creation (never chosen by a caller); the migration restarts
  // the underlying sequence at 10001 so the first company created gets that
  // number rather than 1. Used as a third owner-login identifier alongside
  // email/mobile, and as the entry point for employee login (see
  // AuthService.employeeLogin) - see docs/DOMAIN_MODEL.md "Login and tenant
  // selection".
  subscriptionNumber Int           @unique @default(autoincrement()) @map("subscription_number")
  status             CompanyStatus @default(active)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  branches                    Branch[]
  memberships                 Membership[]
  roles                       Role[]
  membershipRoles             MembershipRole[]
  auditLogs                   AuditLog[]
  integrationConnections      IntegrationConnection[]
  units                       Unit[]
  productCategories           ProductCategory[]
  brands                      Brand[]
  products                    Product[]
  productBarcodes             ProductBarcode[]
  stockLevels                 StockLevel[]
  stockMovements              StockMovement[]
  stockAdjustments            StockAdjustment[]
  stockCounts                 StockCount[]
  stockCountLines             StockCountLine[]
  customers                   Customer[]
  suppliers                   Supplier[]
  sales                       Sale[]
  saleItems                   SaleItem[]
  payments                    Payment[]
  invoices                    Invoice[]
  invoiceSequence             InvoiceSequence?
  purchases                   Purchase[]
  purchaseItems               PurchaseItem[]
  purchaseSequence            PurchaseSequence?
  expenseCategories           ExpenseCategory[]
  expenses                    Expense[]
  accounts                    Account[]
  journalEntries              JournalEntry[]
  journalLines                JournalLine[]
  fiscalPeriods               FiscalPeriod[]
  importJobs                  ImportJob[]
  invoiceCompliance           InvoiceCompliance[]
  supplierPayments            SupplierPayment[]
  saleReturns                 SaleReturn[]
  saleReturnItems             SaleReturnItem[]
  purchaseReturns             PurchaseReturn[]
  purchaseReturnItems         PurchaseReturnItem[]
  bankReconciliations         BankReconciliation[]
  subscription                Subscription?
  integrationCustomerMappings IntegrationCustomerMapping[]
  integrationTransactions     IntegrationTransaction[]
  // Phase 12: users whose username identity is scoped to this company only
  // (see User.homeCompanyId below) - not every Membership's user, just the
  // username-only ones created for/by this company.
  homeUsers                   User[]                       @relation("UserHomeCompany")

  @@map("companies")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  code      String
  address   String?
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company                 Company                  @relation(fields: [companyId], references: [id])
  warehouses              Warehouse[]
  posDevices              PosDevice[]
  membershipRoles         MembershipRole[]
  sales                   Sale[]
  invoices                Invoice[]
  purchases               Purchase[]
  expenses                Expense[]
  journalEntries          JournalEntry[]
  supplierPayments        SupplierPayment[]
  integrationTransactions IntegrationTransaction[]
  saleReturns             SaleReturn[]
  purchaseReturns         PurchaseReturn[]
  bankReconciliations     BankReconciliation[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  name      String
  code      String
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branch Branch @relation(fields: [branchId], references: [id])

  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  stockCounts      StockCount[]
  sales            Sale[]
  purchases        Purchase[]

  @@unique([companyId, code])
  @@index([companyId, branchId, deletedAt])
  @@map("warehouses")
}

enum PosDeviceStatus {
  active
  inactive
}

model PosDevice {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  branchId   String          @map("branch_id") @db.Uuid
  name       String
  deviceCode String          @map("device_code")
  status     PosDeviceStatus @default(active)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  deletedAt  DateTime?       @map("deleted_at")

  branch Branch @relation(fields: [branchId], references: [id])
  sales  Sale[]

  @@unique([companyId, deviceCode])
  @@index([companyId, branchId, deletedAt])
  @@map("pos_devices")
}

// ---------------------------------------------------------------------------
// Identity / Multi-tenant membership / RBAC
// ---------------------------------------------------------------------------
//
// Deliberately separated per docs/DOMAIN_MODEL.md:
//   User        -> global identity, NOT owned by any company. No company_id,
//                  no RLS - a person's account is not tenant data.
//   Membership  -> the ONLY relationship between a User and a Company. One
//                  user can hold many memberships (one per company). This is
//                  the thing that is tenant-scoped and RLS-protected.
//   MembershipRole -> a role assignment, scoped to a Membership (i.e. to a
//                  specific user-in-a-specific-company), never to the user
//                  globally. The same person can be Manager in Company A and
//                  Accountant in Company B via two separate Memberships.
// The access token's "current tenant context" is a membershipId, not just a
// companyId - see AuthService and docs/ARCHITECTURE.md "Identity model".

enum UserStatus {
  active
  disabled
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String     @map("full_name")
  email           String?
  mobile          String?
  // Team members created by a merchant (POS/accountant/...) via IamService.createUser
  // rarely have a real email/mobile - a username lets the merchant set up
  // that identity with only a name, username, and password. Owners created
  // through company registration still use email/mobile as before; this is
  // purely an additional identifier, never required together with them.
  username        String?
  // Phase 12: set only for a user created via a username (IamService.createUser,
  // the branch above) - the ONE company that account belongs to. NULL for
  // email/mobile-based accounts (owners, invited members), which stay a
  // single global identity usable across every company's Membership as
  // before. This is what makes `username` collision-free BETWEEN companies
  // (see @@unique([homeCompanyId, username]) below) without requiring a
  // platform-wide unique username - two different companies' cashiers can
  // both be "ahmed". Employee login (AuthService.employeeLogin) resolves a
  // username within a company already identified by subscriptionNumber, so
  // this is also what that lookup filters on.
  homeCompanyId   String?    @map("home_company_id") @db.Uuid
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(active)
  locale          String     @default("ar")
  // Website phase: set the first time EmailVerificationService.verify()
  // succeeds for this user. Deliberately NOT enforced as a login/access
  // gate yet (see docs/WEBSITE.md "Email verification") - registration
  // still issues tokens immediately, matching every existing
  // register-company caller/test. This column exists so verification is
  // real, persisted state a merchant/admin can see, not a UI-only flag.
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  homeCompany             Company?                 @relation("UserHomeCompany", fields: [homeCompanyId], references: [id])

  // Globally unique on purpose: one person, one login identity, usable
  // across every company they hold a Membership in. Login resolves the
  // user first (no RLS involved - this table isn't tenant data), then
  // resolves their memberships to determine/select the tenant context.
  @@unique([email])
  @@unique([mobile])
  // Phase 12: replaces the old global @@unique([username]) - see
  // homeCompanyId comment above. Two NULL,NULL rows (every email/mobile
  // account with no username) never collide under standard unique-index
  // NULL semantics, so this is a no-op for every account this schema had
  // before Phase 12.
  @@unique([homeCompanyId, username])
  @@index([deletedAt])
  @@map("users")
}

enum PlatformAdminStatus {
  active
  disabled
}

// Control Center RBAC (Website phase) - deliberately a single role field,
// not a full permission-key system like tenant IAM's Role/Permission/
// RolePermission: the Control Center has a handful of fixed sections
// (merchants, subscriptions, plans, markets, affiliates, applications,
// staff), not an open-ended per-tenant-customizable permission catalog.
// `admin` is the only role that can manage staff/plans/markets - every
// other role is read/act-scoped to its own section (RequirePlatformAdminRole
// guard, platform-admin.controller.ts).
enum PlatformAdminRole {
  admin
  finance
  support
  marketing
  developer
}

// The SaaS control-panel actor: an Anthropic/Qeedha-side operator who can
// create merchant companies on their behalf and see the platform across
// every tenant. Deliberately a SEPARATE identity from `User` - it is not a
// Membership, holds no company_id, and is never RLS-scoped - because
// "sees every company" and "is scoped to exactly one company at a time"
// are fundamentally different trust levels that must never share one
// login/session mechanism (see PlatformAdminAuthGuard, and
// prisma/manual-sql/004_platform_admin_role.sql for how it reads
// `companies` across every tenant without touching the narrow
// qeedha_auth_lookup role's grants).
model PlatformAdmin {
  id           String              @id @default(uuid()) @db.Uuid
  fullName     String              @map("full_name")
  email        String              @unique
  passwordHash String              @map("password_hash")
  role         PlatformAdminRole   @default(admin)
  status       PlatformAdminStatus @default(active)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("platform_admins")
}

enum MembershipStatus {
  active
  suspended
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  company                             Company                 @relation(fields: [companyId], references: [id])
  user                                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipRoles                     MembershipRole[]
  refreshTokens                       RefreshToken[]
  // Milestone 9: set on the ONE Membership (a dedicated non-human "Integration"
  // system identity - see docs/QEEDHA_INTEGRATION.md "System actor") that acts
  // as the audit/branch-scope actor for business calls this connection makes.
  integrationConnectionsAsSystemActor IntegrationConnection[] @relation("IntegrationConnectionSystemMembership")

  @@unique([companyId, userId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid // NULL = دور نظامي عام لكل المنشآت
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company         Company?         @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  category    String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String   @id @default(uuid()) @db.Uuid
  // Denormalized alongside membershipId (same pattern as elsewhere in this
  // schema): keeps the RLS policy a flat `company_id = ...` check with no
  // join, and keeps tenant-scoped indexes simple.
  companyId    String   @map("company_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid // NULL = نطاق المنشأة كاملة
  createdAt    DateTime @default(now()) @map("created_at")

  company    Company    @relation(fields: [companyId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  @@unique([membershipId, roleId, branchId])
  @@index([companyId, membershipId])
  @@map("membership_roles")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  // A refresh token represents a session inside ONE already-selected tenant
  // context, so it caches membershipId (+ companyId) at issuance time. This
  // is what lets /auth/refresh mint a new access token for the same tenant
  // without re-running tenant selection on every 15-minute expiry, and
  // without needing RLS-bypass access - the values are trusted because they
  // were only ever written by AuthService.issueTokens() after a real
  // membership check. Not RLS-protected itself (no policy below): scoped by
  // userId per query, never listed cross-user, so tenant isolation doesn't
  // apply the same way it does to actual business data.
  membershipId      String    @map("membership_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Website phase - see docs/WEBSITE.md "Email verification". Same
// hashed-opaque-token pattern as RefreshToken (tokenHash unique, never
// store the raw token). Not RLS-protected: same reasoning as RefreshToken
// (users carries no company_id, this isn't tenant data).
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Integration Layer (بنية عامة فقط - بدون أي Provider فعلي في هذه المرحلة)
// ---------------------------------------------------------------------------

model IntegrationProvider {
  key               String   @id // e.g. "qeedha" - registered later, not seeded with business logic
  name              String
  category          String // payment | erp | ecommerce | other
  isEnabledGlobally Boolean  @default(false) @map("is_enabled_globally")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  connections IntegrationConnection[]

  @@map("integration_providers")
}

enum IntegrationConnectionStatus {
  not_connected
  connecting
  connected
  needs_reauth
  disabled
}

model IntegrationConnection {
  id                   String                      @id @default(uuid()) @db.Uuid
  companyId            String                      @map("company_id") @db.Uuid
  providerKey          String                      @map("provider_key")
  status               IntegrationConnectionStatus @default(not_connected)
  credentialsEncrypted String?                     @map("credentials_encrypted")
  connectedAt          DateTime?                   @map("connected_at")
  lastVerifiedAt       DateTime?                   @map("last_verified_at")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  // Milestone 9 (docs/QEEDHA_INTEGRATION.md "Inbound API contract"): fields
  // for the INBOUND direction - an external system (Qeedha) authenticating
  // ITS calls into Qeedha B, as opposed to `credentialsEncrypted` above
  // (reserved for the still-unbuilt OUTBOUND direction: Qeedha B calling out
  // via PaymentIntegrationPort/IntegrationRegistry - untouched, unrelated).
  // `publicReference` is the only "External Merchant ID" ever exposed to the
  // caller - never this row's own `id`. `secretHash` is a SHA-256 hash (same
  // `hashToken` utility as refresh tokens) of a secret shown to the merchant
  // exactly once at link time and never stored/logged in raw form.
  publicReference    String?   @unique @map("public_reference")
  secretHash         String?   @map("secret_hash")
  secretLastFour     String?   @map("secret_last_four")
  systemMembershipId String?   @map("system_membership_id") @db.Uuid
  revokedAt          DateTime? @map("revoked_at")

  company          Company                      @relation(fields: [companyId], references: [id])
  provider         IntegrationProvider          @relation(fields: [providerKey], references: [key])
  systemMembership Membership?                  @relation("IntegrationConnectionSystemMembership", fields: [systemMembershipId], references: [id])
  customerMappings IntegrationCustomerMapping[]
  transactions     IntegrationTransaction[]

  @@unique([companyId, providerKey])
  @@map("integration_connections")
}

enum WebhookProcessingStatus {
  received
  processed
  failed
}

model WebhookEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  providerKey      String                  @map("provider_key")
  receivedAt       DateTime                @default(now()) @map("received_at")
  headers          Json
  payload          Json
  processingStatus WebhookProcessingStatus @default(received) @map("processing_status")
  processedAt      DateTime?               @map("processed_at")

  @@index([providerKey, processingStatus])
  @@map("webhook_events")
}

// Milestone 9: External Customer Reference <-> Qeedha B Customer, scoped to
// ONE connection (never global per company) so two different external
// systems can never collide on the same reference string. Tenant-scoped,
// RLS FORCE like every other business table - see docs/DATABASE.md
// "Milestone 9".
model IntegrationCustomerMapping {
  id                        String   @id @default(uuid()) @db.Uuid
  companyId                 String   @map("company_id") @db.Uuid
  connectionId              String   @map("connection_id") @db.Uuid
  externalCustomerReference String   @map("external_customer_reference")
  customerId                String   @map("customer_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  company    Company               @relation(fields: [companyId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])
  customer   Customer              @relation(fields: [customerId], references: [id])

  @@unique([companyId, connectionId, externalCustomerReference])
  @@index([companyId, customerId])
  @@map("integration_customer_mappings")
}

enum IntegrationTransactionStatus {
  success
  failed
  cancelled
}

// Milestone 9: the idempotency ledger + external-reference lookup table for
// every inbound integration transaction. `idempotencyKey` is the real
// dedup key (same `clientReferenceId` pattern used everywhere else in this
// codebase - Sale/Purchase/Payment/Expense/ImportJob); `externalTransactionId`
// is the caller's own descriptive reference, stored for lookup/display but
// not itself the uniqueness guarantee (a caller's ID scheme is theirs to
// manage, not ours to constrain). No amount/currency/accounting value here
// is ever treated as authoritative on its own - `paymentId`/`saleId` point
// at the real trusted rows created by SalesService.
model IntegrationTransaction {
  id                    String                       @id @default(uuid()) @db.Uuid
  companyId             String                       @map("company_id") @db.Uuid
  connectionId          String                       @map("connection_id") @db.Uuid
  branchId              String                       @map("branch_id") @db.Uuid
  saleId                String?                      @map("sale_id") @db.Uuid
  paymentId             String?                      @unique @map("payment_id") @db.Uuid
  customerId            String?                      @map("customer_id") @db.Uuid
  externalTransactionId String                       @map("external_transaction_id")
  idempotencyKey        String                       @map("idempotency_key")
  status                IntegrationTransactionStatus
  amount                Decimal                      @db.Decimal(14, 2)
  currencyCode          String                       @map("currency_code")
  invoiceReference      String                       @map("invoice_reference")
  branchReference       String                       @map("branch_reference")
  failureReason         String?                      @map("failure_reason")
  cancelledAt           DateTime?                    @map("cancelled_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  company    Company               @relation(fields: [companyId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])
  branch     Branch                @relation(fields: [branchId], references: [id])
  sale       Sale?                 @relation(fields: [saleId], references: [id])
  payment    Payment?              @relation(fields: [paymentId], references: [id])
  customer   Customer?             @relation(fields: [customerId], references: [id])

  @@unique([companyId, connectionId, idempotencyKey])
  @@index([companyId, connectionId, externalTransactionId])
  @@index([companyId, status])
  @@map("integration_transactions")
}

// ---------------------------------------------------------------------------
// Phase 2: Catalog (Products, Categories, Brands, Units)
// ---------------------------------------------------------------------------
//
// Uniqueness rules (see docs/DOMAIN_MODEL.md "Phase 2 identifiers"):
//   - SKU: unique per company, never globally - two tenants selling
//     unrelated things may reuse the same short code.
//   - Barcode: unique per company, never globally - the same GS1 barcode
//     legitimately exists in many unrelated tenants' catalogs.
//   - Category/Brand name: NOT DB-unique (duplicate display names are a
//     real merchant scenario); cross-tenant reference integrity is
//     enforced at the application layer (every service verifies a
//     referenced category/brand/unit's companyId matches before use),
//     because a bare FK alone cannot express "same tenant AND same row".

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  symbol    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
  @@map("units")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company  Company           @relation(fields: [companyId], references: [id])
  parent   ProductCategory?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryChildren")
  products Product[]

  @@index([companyId, parentId, deletedAt])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
  @@map("brands")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  sku               String
  name              String
  description       String?
  categoryId        String?   @map("category_id") @db.Uuid
  brandId           String?   @map("brand_id") @db.Uuid
  unitId            String?   @map("unit_id") @db.Uuid
  costPrice         Decimal   @map("cost_price") @db.Decimal(14, 2)
  sellingPrice      Decimal   @map("selling_price") @db.Decimal(14, 2)
  vatRate           Decimal   @default(15) @map("vat_rate") @db.Decimal(5, 2)
  isActive          Boolean   @default(true) @map("is_active")
  minStockThreshold Decimal   @default(0) @map("min_stock_threshold") @db.Decimal(14, 3)
  // Storage key only (e.g. "products/<companyId>/<productId>/<file>"), never
  // a public URL - see docs/SECURITY.md "Product images" once image upload
  // ships. Column exists now so it never needs a later migration.
  imageKey          String?   @map("image_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  company             Company              @relation(fields: [companyId], references: [id])
  category            ProductCategory?     @relation(fields: [categoryId], references: [id])
  brand               Brand?               @relation(fields: [brandId], references: [id])
  unit                Unit?                @relation(fields: [unitId], references: [id])
  barcodes            ProductBarcode[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  stockCountLines     StockCountLine[]
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@unique([companyId, sku])
  @@index([companyId, deletedAt])
  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([companyId, categoryId])
  @@map("products")
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  barcode   String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, barcode])
  @@index([companyId, productId])
  @@map("product_barcodes")
}

// ---------------------------------------------------------------------------
// Phase 2: Inventory
// ---------------------------------------------------------------------------
//
// stock_levels is a materialized cache, never written directly except by
// InventoryService.recordMovement() inside the same transaction as the
// stock_movements row that justifies the change - see docs/INVENTORY.md
// "Concurrency strategy" for the atomic guarded UPDATE that makes this safe
// under concurrent requests without explicit row locking.

model StockLevel {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(14, 3)
  // Foundation for Phase 3 POS/Sales (held carts reserving stock before
  // payment) - always 0 in Phase 2, nothing writes to it yet.
  // availableQuantity = quantityOnHand - reservedQuantity, computed at read
  // time (never stored, to avoid drift).
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(14, 3)
  // Milestone 6: moving weighted-average cost per unit (docs/ACCOUNTING.md
  // "COGS / Inventory Valuation") - Decimal(14,4), one more fractional digit
  // than money columns, since this is a per-unit RATE that gets multiplied by
  // quantity, not a money amount itself; rounding it to 2dp before storing
  // would compound drift over many receipts. Written ONLY by
  // InventoryService.recordMovement's atomic guarded UPDATE, in the same
  // statement as quantityOnHand - never updated independently.
  averageCost      Decimal  @default(0) @map("average_cost") @db.Decimal(14, 4)
  updatedAt        DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([companyId, warehouseId, productId])
  @@index([companyId, productId])
  @@map("stock_levels")
}

enum StockMovementType {
  opening_balance
  purchase
  sale
  return
  adjustment
  transfer_in
  transfer_out
  damage
  expiry
  manual_correction
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  warehouseId       String            @map("warehouse_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  type              StockMovementType
  // Signed: positive = stock in, negative = stock out. Lets a plain SUM()
  // per (warehouse, product) double as an independent reconciliation check
  // against stock_levels.quantity_on_hand.
  quantity          Decimal           @db.Decimal(14, 3)
  referenceType     String?           @map("reference_type")
  referenceId       String?           @map("reference_id")
  actorMembershipId String?           @map("actor_membership_id") @db.Uuid
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([companyId, warehouseId, productId, createdAt])
  @@index([companyId, referenceType, referenceId])
  @@map("stock_movements")
}

model StockAdjustment {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  quantityDelta     Decimal  @map("quantity_delta") @db.Decimal(14, 3)
  reason            String
  notes             String?
  actorMembershipId String   @map("actor_membership_id") @db.Uuid
  stockMovementId   String   @unique @map("stock_movement_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([companyId, warehouseId, productId])
  @@map("stock_adjustments")
}

enum StockCountStatus {
  draft
  completed
  cancelled
}

model StockCount {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  warehouseId       String           @map("warehouse_id") @db.Uuid
  status            StockCountStatus @default(draft)
  actorMembershipId String           @map("actor_membership_id") @db.Uuid
  notes             String?
  startedAt         DateTime         @default(now()) @map("started_at")
  completedAt       DateTime?        @map("completed_at")

  company   Company          @relation(fields: [companyId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     StockCountLine[]

  @@index([companyId, warehouseId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  stockCountId     String   @map("stock_count_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  expectedQuantity Decimal  @map("expected_quantity") @db.Decimal(14, 3)
  // NULL = not counted yet. difference = countedQuantity - expectedQuantity,
  // computed at read time, never stored.
  countedQuantity  Decimal? @map("counted_quantity") @db.Decimal(14, 3)

  company    Company    @relation(fields: [companyId], references: [id])
  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([stockCountId, productId])
  @@index([companyId, stockCountId])
  @@map("stock_count_lines")
}

// ---------------------------------------------------------------------------
// Phase 2: Parties (Customers, Suppliers)
// ---------------------------------------------------------------------------

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?   @map("tax_number")
  reference String?
  notes     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company                 Company                      @relation(fields: [companyId], references: [id])
  sales                   Sale[]
  invoices                Invoice[]
  integrationMappings     IntegrationCustomerMapping[]
  integrationTransactions IntegrationTransaction[]

  @@unique([companyId, reference])
  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@map("customers")
}

model Supplier {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String
  contactPerson String?   @map("contact_person")
  phone         String?
  email         String?
  address       String?
  taxNumber     String?   @map("tax_number")
  reference     String?
  notes         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company          Company           @relation(fields: [companyId], references: [id])
  purchases        Purchase[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, reference])
  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Phase 3: Sales, Payments, Invoices
// ---------------------------------------------------------------------------
//
// POS is a UI concept, not a database model of its own - see docs/POS.md. The
// domain transaction is Sale (+ SaleItem, + Payment, + Invoice), independent
// of whatever screen created it. branchId on Sale/Invoice is ALWAYS derived
// server-side from warehouse.branchId, never trusted from the client - see
// docs/SECURITY.md "POS/Sale authorization".

enum SaleStatus {
  completed
  cancelled
}

enum PaymentMethod {
  cash
  card
  transfer
  other
  // Routed through the Phase 1 PaymentIntegrationPort/IntegrationRegistry
  // (modules/integrations) instead of being handled directly by this module.
  // No adapter is registered for any real provider yet - see
  // docs/INTEGRATION.md "Payment provider foundation".
  external
}

enum PaymentStatus {
  pending
  success
  failed
  cancelled
  refunded
}

enum InvoiceStatus {
  issued
  cancelled
}

model Sale {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  // Derived server-side from warehouse.branchId at creation time - never a
  // client-supplied value. See assertSaleAuthorization in SalesService.
  branchId    String  @map("branch_id") @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  posDeviceId String? @map("pos_device_id") @db.Uuid
  customerId  String? @map("customer_id") @db.Uuid

  status SaleStatus @default(completed)

  currency       String  @default("SAR")
  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(14, 2)

  // Client/POS-generated idempotency key - see docs/SALES.md "Idempotency".
  // Unique per company: a retried request with the same key returns the
  // already-created sale instead of creating a duplicate.
  clientReferenceId String @map("client_reference_id")

  actorMembershipId String    @map("actor_membership_id") @db.Uuid
  cancelledAt       DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                 Company                  @relation(fields: [companyId], references: [id])
  branch                  Branch                   @relation(fields: [branchId], references: [id])
  warehouse               Warehouse                @relation(fields: [warehouseId], references: [id])
  posDevice               PosDevice?               @relation(fields: [posDeviceId], references: [id])
  customer                Customer?                @relation(fields: [customerId], references: [id])
  items                   SaleItem[]
  payments                Payment[]
  invoice                 Invoice?
  saleReturns             SaleReturn[]
  integrationTransactions IntegrationTransaction[]

  @@unique([companyId, clientReferenceId])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  saleId    String @map("sale_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  // Snapshot at time of sale (docs/SALES.md "Snapshot design") - a later
  // change to the product's name/price/SKU/tax must NEVER alter a past
  // invoice. Only what's needed to render/re-derive a historical line is
  // copied; everything else (category, brand, image, ...) is looked up live
  // via `product` when still needed, since that's display-only and doesn't
  // affect the recorded transaction amounts.
  productName String  @map("product_name")
  productSku  String  @map("product_sku")
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  vatRate     Decimal @map("vat_rate") @db.Decimal(5, 2)

  quantity       Decimal @db.Decimal(14, 3)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  lineSubtotal   Decimal @map("line_subtotal") @db.Decimal(14, 2)
  lineTax        Decimal @map("line_tax") @db.Decimal(14, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)

  // Milestone 6: the weighted-average cost per unit AT THE MOMENT OF SALE,
  // captured from InventoryValuationService.recordIssue so the COGS journal
  // line is reproducible/auditable after the fact, and so cancelSale can
  // return stock to inventory at the SAME cost it left at (not whatever the
  // average happens to be after later purchases) - see docs/ACCOUNTING.md
  // "COGS / Inventory Valuation" "Returns". NULL for every SaleItem created
  // before this migration (docs/ACCOUNTING.md "Legacy data") - those sales
  // never posted a COGS line, so there is nothing to reproduce.
  unitCost Decimal? @map("unit_cost") @db.Decimal(14, 4)

  company         Company          @relation(fields: [companyId], references: [id])
  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id])
  saleReturnItems SaleReturnItem[]

  @@index([companyId, saleId])
  @@index([companyId, productId])
  @@map("sale_items")
}

model Payment {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  saleId    String @map("sale_id") @db.Uuid

  method   PaymentMethod
  status   PaymentStatus @default(success)
  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("SAR")

  // Only meaningful when method = external (docs/INTEGRATION.md). NULL for
  // cash/card/transfer/other - there is no external call to reference.
  providerKey       String? @map("provider_key")
  externalReference String? @map("external_reference")
  idempotencyKey    String? @map("idempotency_key")

  // Milestone 7: idempotency key for a standalone "record payment against an
  // existing sale" request (AR settlement) - NULL for payments created
  // inline at sale-creation time (those are already deduplicated via
  // Sale.clientReferenceId). Postgres allows multiple NULLs in a unique
  // index, so old/inline rows are unaffected.
  clientReferenceId String? @map("client_reference_id")

  actorMembershipId String   @map("actor_membership_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company                Company                 @relation(fields: [companyId], references: [id])
  sale                   Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  integrationTransaction IntegrationTransaction?

  @@unique([companyId, clientReferenceId])
  @@index([companyId, saleId])
  @@map("payments")
}

/// Milestone 7: a payment made TO a supplier settling (part of) a specific
/// Purchase's Accounts Payable balance. Mirrors Payment, but purchaseId is
/// required (not optional) - a supplier payment always settles one specific
/// purchase invoice, matching how AR/AP balances are derived purely from
/// posted JournalLines (see SubledgerService) rather than a stored balance
/// field, so every payment must reference the invoice it reduces.
model SupplierPayment {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid

  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  currency  String        @default("SAR")
  reference String? // free-text bank/cheque/transfer reference

  // Idempotency key, same model as Sale/Purchase.clientReferenceId.
  clientReferenceId String @map("client_reference_id")

  actorMembershipId String   @map("actor_membership_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])

  @@unique([companyId, clientReferenceId])
  @@index([companyId, purchaseId])
  @@index([companyId, supplierId])
  @@map("supplier_payments")
}

/// Milestone 7: a genuine partial/full return of previously sold items,
/// distinct from Sale.cancelledAt (a full-sale void). Referenced by UUID
/// only (no human-readable sequence), matching internal correcting
/// transactions like StockAdjustment/StockTransfer rather than
/// customer-facing documents like Invoice/Purchase.
model SaleReturn {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  reason    String?

  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(14, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(14, 2)

  clientReferenceId String @map("client_reference_id")

  actorMembershipId String   @map("actor_membership_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company Company          @relation(fields: [companyId], references: [id])
  branch  Branch           @relation(fields: [branchId], references: [id])
  sale    Sale             @relation(fields: [saleId], references: [id])
  items   SaleReturnItem[]

  @@unique([companyId, clientReferenceId])
  @@index([companyId, saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  saleReturnId String @map("sale_return_id") @db.Uuid
  saleItemId   String @map("sale_item_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  vatRate   Decimal @map("vat_rate") @db.Decimal(5, 2)

  // Copied from SaleItem.unitCost at return time - preserves the ORIGINAL
  // sale-time cost for COGS/inventory reversal (docs/ACCOUNTING.md "COGS /
  // Inventory Valuation"). NULL when the original SaleItem.unitCost is NULL
  // (legacy pre-Milestone-6 rows) - see SalesReturnService fallback.
  unitCost Decimal? @map("unit_cost") @db.Decimal(14, 4)

  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(14, 2)
  lineTax      Decimal @map("line_tax") @db.Decimal(14, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(14, 2)

  company    Company    @relation(fields: [companyId], references: [id])
  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([companyId, saleReturnId])
  @@index([companyId, saleItemId])
  @@map("sale_return_items")
}

/// Milestone 7: a genuine partial/full return of previously received
/// purchase items to a supplier. Mirrors SaleReturn.
model PurchaseReturn {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  purchaseId String  @map("purchase_id") @db.Uuid
  reason     String?

  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(14, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(14, 2)

  clientReferenceId String @map("client_reference_id")

  actorMembershipId String   @map("actor_membership_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company  Company              @relation(fields: [companyId], references: [id])
  branch   Branch               @relation(fields: [branchId], references: [id])
  purchase Purchase             @relation(fields: [purchaseId], references: [id])
  items    PurchaseReturnItem[]

  @@unique([companyId, clientReferenceId])
  @@index([companyId, purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String @id @default(uuid()) @db.Uuid
  companyId        String @map("company_id") @db.Uuid
  purchaseReturnId String @map("purchase_return_id") @db.Uuid
  purchaseItemId   String @map("purchase_item_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid

  quantity Decimal @db.Decimal(14, 3)
  unitCost Decimal @map("unit_cost") @db.Decimal(14, 2)
  vatRate  Decimal @map("vat_rate") @db.Decimal(5, 2)

  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(14, 2)
  lineTax      Decimal @map("line_tax") @db.Decimal(14, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(14, 2)

  company        Company        @relation(fields: [companyId], references: [id])
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  @@index([companyId, purchaseReturnId])
  @@index([companyId, purchaseItemId])
  @@map("purchase_return_items")
}

/// Milestone 7: a minimal, header-only internal reconciliation record
/// comparing the book (GL) balance of a cash/bank account against an
/// externally-reported statement balance as of a given date. Deliberately
/// no line-level transaction-matching table - see docs/ACCOUNTING.md "Bank
/// Reconciliation" for why per-line matching is documented as a deferred
/// scope decision rather than built here. Create = immediately complete
/// (immutable), like AuditLog - there is no draft/in-progress state.
model BankReconciliation {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  branchId  String? @map("branch_id") @db.Uuid

  // ACCOUNT_CODES value (e.g. '1010' cash, '1020' bank) - a fixed code, not
  // an Account row FK, matching the existing Account Mapping convention of
  // referencing chart-of-accounts codes rather than IDs.
  accountCode String @map("account_code")

  asOfDate         DateTime @map("as_of_date") @db.Date
  statementBalance Decimal  @map("statement_balance") @db.Decimal(14, 2)
  bookBalance      Decimal  @map("book_balance") @db.Decimal(14, 2)
  difference       Decimal  @db.Decimal(14, 2)
  notes            String?

  actorMembershipId String   @map("actor_membership_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@index([companyId, accountCode, asOfDate])
  @@map("bank_reconciliations")
}

/// One row per company - an atomic, tenant-scoped invoice number counter.
/// See docs/INVOICES.md "Numbering" for the guarded-UPDATE mechanism (same
/// pattern as InventoryService.recordMovement's atomic stock update).
model InvoiceSequence {
  companyId  String @id @map("company_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  company Company @relation(fields: [companyId], references: [id])

  @@map("invoice_sequences")
}

model Invoice {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  saleId     String  @unique @map("sale_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(issued)

  currency       String  @default("SAR")
  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(14, 2)

  issuedAt    DateTime  @default(now()) @map("issued_at")
  cancelledAt DateTime? @map("cancelled_at")

  company    Company            @relation(fields: [companyId], references: [id])
  branch     Branch             @relation(fields: [branchId], references: [id])
  sale       Sale               @relation(fields: [saleId], references: [id])
  customer   Customer?          @relation(fields: [customerId], references: [id])
  compliance InvoiceCompliance?

  @@unique([companyId, invoiceNumber])
  @@index([companyId, customerId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Milestone 4: ZATCA E-Invoicing Readiness (Phase 1 only - see docs/ZATCA.md)
// ---------------------------------------------------------------------------
//
// Deliberately a SEPARATE table from Invoice, not new columns bolted onto it
// (matches the placeholder already sketched in docs/DATABASE.md §9 before
// this milestone) - Invoice stays the internal business record; this table
// is the "does ZATCA know about this invoice, and how" record, kept
// entirely out of SalesService/InvoicesService's own concerns. Every
// Invoice this system produces originates from a POS Sale to a walk-in/
// retail customer, so it is always a ZATCA "simplified" (B2C) tax invoice -
// there is no B2B sales-invoicing path in this system, so no separate
// invoice_type column is needed (see docs/ZATCA.md "Invoice classification").

enum EInvoiceStatus {
  // The only value ever actually set today - Phase 1 (Generation) is local
  // QR generation only, no external submission exists (no Phase 2 adapter,
  // no ZATCA credentials/contract - see EInvoiceService and
  // ports/zatca-provider.port.ts).
  not_submitted
  // Reserved for Phase 2 (Integration), once a real ZATCA API
  // contract/CSID/credentials exist and a ZatcaProvider adapter is built -
  // NOT used by any code path in this milestone. Declared now purely so a
  // future Phase 2 migration doesn't need an enum ALTER (see
  // docs/DATABASE.md §9 for the full reasoning).
  pending
  reported
  cleared
  rejected
}

model InvoiceCompliance {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  invoiceId String         @unique @map("invoice_id") @db.Uuid
  status    EInvoiceStatus @default(not_submitted)

  // Base64-encoded TLV (Tag-Length-Value) payload per ZATCA Phase 1's
  // published QR specification for simplified tax invoices - see
  // EInvoiceService/TlvQrService for the encoder and docs/ZATCA.md for the
  // verified field list and sourcing. NULL when the seller's VAT
  // registration number isn't on file yet (Company.vatNumber is optional at
  // registration) - never generated with a blank/placeholder VAT number,
  // since that would not be a correct QR payload.
  qrCode      String?   @map("qr_code")
  generatedAt DateTime? @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([companyId, status])
  @@map("invoice_compliance")
}

// ---------------------------------------------------------------------------
// Phase 4: Purchasing
// ---------------------------------------------------------------------------
//
// Deliberately no separate PurchaseInvoice table (unlike Sale/Invoice in
// Phase 3): a supplier bill here is always 1:1 with its single receiving
// event, with no distinct future use identified yet that would justify the
// split - see docs/PURCHASING.md. Purchase IS the bill record.
//
// Purchases post as unpaid (Accounts Payable) on receipt - there is no
// "pay supplier" step in this phase (docs/ACCOUNTING.md "Deferred").

enum PurchaseStatus {
  ordered
  received
  cancelled
}

model Purchase {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  // Derived server-side from warehouseId, exactly like Sale.branchId - never
  // a client-supplied value. See assertPurchaseAuthorization in
  // PurchasesService.
  branchId    String @map("branch_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  supplierId  String @map("supplier_id") @db.Uuid

  status PurchaseStatus @default(ordered)

  currency       String  @default("SAR")
  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(14, 2)

  // Atomically issued, tenant-scoped (docs/PURCHASING.md "Numbering" - same
  // guarded-UPDATE pattern as InvoiceNumberService).
  referenceNumber String @map("reference_number")

  // Idempotency key, same model as Sale.clientReferenceId.
  clientReferenceId String @map("client_reference_id")

  actorMembershipId String    @map("actor_membership_id") @db.Uuid
  receivedAt        DateTime? @map("received_at")
  cancelledAt       DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  items            PurchaseItem[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]

  @@unique([companyId, clientReferenceId])
  @@unique([companyId, referenceNumber])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, supplierId])
  @@index([companyId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid

  // Snapshot at time of purchase - same rationale as SaleItem
  // (docs/SALES.md "Snapshot design"): a later product change must not
  // alter a historical purchase bill.
  productName String  @map("product_name")
  productSku  String  @map("product_sku")
  unitCost    Decimal @map("unit_cost") @db.Decimal(14, 2)
  vatRate     Decimal @map("vat_rate") @db.Decimal(5, 2)

  quantity       Decimal @db.Decimal(14, 3)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  lineSubtotal   Decimal @map("line_subtotal") @db.Decimal(14, 2)
  lineTax        Decimal @map("line_tax") @db.Decimal(14, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)

  company             Company              @relation(fields: [companyId], references: [id])
  purchase            Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])
  purchaseReturnItems PurchaseReturnItem[]

  @@index([companyId, purchaseId])
  @@index([companyId, productId])
  @@map("purchase_items")
}

/// One row per company - atomic purchase reference-number counter, same
/// pattern as InvoiceSequence.
model PurchaseSequence {
  companyId  String @id @map("company_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  company Company @relation(fields: [companyId], references: [id])

  @@map("purchase_sequences")
}

// ---------------------------------------------------------------------------
// Phase 4: Expenses
// ---------------------------------------------------------------------------
//
// Expenses are always recorded as already paid (paymentMethod is required,
// mirroring Payment.method's local values) - there is no "unpaid expense /
// expense payable" tracking in this phase, see docs/EXPENSES.md "Deferred".

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  // The expense (P&L) account this category posts to - the concrete
  // "Account Mapping" for expenses (docs/ACCOUNTING.md "Account Mapping").
  accountId String   @map("account_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  account  Account   @relation(fields: [accountId], references: [id])
  expenses Expense[]

  @@unique([companyId, name])
  @@map("expense_categories")
}

enum ExpenseStatus {
  recorded
  cancelled
}

model Expense {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  // Optional on purpose (docs/EXPENSES.md): a company-level expense (e.g.
  // head-office software subscription) is not forced onto a branch. When
  // present, branch scope is enforced exactly like Sale/Purchase.
  branchId   String? @map("branch_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid

  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("SAR")
  paymentMethod PaymentMethod @map("payment_method")
  description   String?
  reference     String?
  status        ExpenseStatus @default(recorded)

  clientReferenceId String @map("client_reference_id")

  actorMembershipId String    @map("actor_membership_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  cancelledAt       DateTime? @map("cancelled_at")

  company  Company         @relation(fields: [companyId], references: [id])
  branch   Branch?         @relation(fields: [branchId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([companyId, clientReferenceId])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, categoryId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Phase 4: Accounting - Chart of Accounts + double-entry Journal
// ---------------------------------------------------------------------------
//
// docs/ACCOUNTING.md documents the full design and the accounting policy
// decisions flagged explicitly rather than guessed (inventory
// valuation/COGS deferred, no manual journal entry endpoint - every entry
// is posted by JournalService.postJournalEntry() from Sales/Purchases/
// Expenses, matching the "no manual double entry" principle already
// recorded in docs/DATABASE.md since Phase 1).

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

model Account {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  code      String
  name      String
  type      AccountType
  parentId  String?     @map("parent_id") @db.Uuid
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  company           Company           @relation(fields: [companyId], references: [id])
  parent            Account?          @relation("AccountChildren", fields: [parentId], references: [id])
  children          Account[]         @relation("AccountChildren")
  journalLines      JournalLine[]
  expenseCategories ExpenseCategory[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, parentId])
  @@map("accounts")
}

/// `reversed` marks that this entry's effect has been undone by a newer
/// entry referencing it via `reversalOfEntryId` - the original's lines are
/// NEVER mutated or deleted (docs/JOURNAL_ENTRIES.md "Posted vs corrections").
enum JournalEntryStatus {
  posted
  reversed
}

model JournalEntry {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  branchId  String? @map("branch_id") @db.Uuid

  status JournalEntryStatus @default(posted)

  // Which operational transaction this entry belongs to - 'Sale' |
  // 'Purchase' | 'Expense' | 'JournalEntry' (a reversal referencing the
  // entry it reverses, in addition to reversalOfEntryId below).
  referenceType String  @map("reference_type")
  referenceId   String  @map("reference_id")
  description   String?

  reversalOfEntryId String? @map("reversal_of_entry_id") @db.Uuid

  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  postedAt          DateTime @default(now()) @map("posted_at")

  company    Company        @relation(fields: [companyId], references: [id])
  branch     Branch?        @relation(fields: [branchId], references: [id])
  reversalOf JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversals  JournalEntry[] @relation("JournalEntryReversal")
  lines      JournalLine[]

  @@index([companyId, referenceType, referenceId])
  @@index([companyId, postedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String @id @default(uuid()) @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid

  debit       Decimal @default(0) @db.Decimal(14, 2)
  credit      Decimal @default(0) @db.Decimal(14, 2)
  description String?

  company      Company      @relation(fields: [companyId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([companyId, journalEntryId])
  @@index([companyId, accountId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Milestone 1: Fiscal Periods
// ---------------------------------------------------------------------------
//
// Simple, extensible period lock (docs/ACCOUNTING.md "Fiscal Periods"): once
// CLOSED, JournalService refuses to post/reverse any entry whose posting date
// (always "now" - there is no backdating in this system) falls inside it.
// Does NOT change the reversal-not-mutation principle - closing a period
// never touches a posted entry's lines. Non-overlap between periods of the
// same company is enforced in FiscalPeriodsService, not a DB constraint,
// matching the rest of this schema's business-rule enforcement style.

enum FiscalPeriodStatus {
  open
  closed
}

model FiscalPeriod {
  id        String             @id @default(uuid()) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  name      String
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    FiscalPeriodStatus @default(open)

  closedAt             DateTime? @map("closed_at")
  closedByMembershipId String?   @map("closed_by_membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, startDate, endDate])
  @@index([companyId, status])
  @@map("fiscal_periods")
}

// ---------------------------------------------------------------------------
// Milestone 3: Excel Import
// ---------------------------------------------------------------------------
//
// File bytes never live in the database - only a storage key
// ("imports/<companyId>/<jobId>/source.xlsx", always server-generated, never
// derived from the client's filename - see StorageService/ImportsService) and
// small metadata do. This mirrors the existing Product.imageKey convention
// (a plain string column, no separate "Files" table) rather than inventing a
// new generic file model - the StorageService abstraction (code, not a
// table) is what's reusable across future features.

enum ImportEntityType {
  products
  barcodes
  categories
  units
  customers
  suppliers
  opening_stock
}

enum ImportJobStatus {
  uploaded
  analyzing
  ready
  validating
  validated
  importing
  completed
  failed
  cancelled
}

model ImportJob {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  actorMembershipId String           @map("actor_membership_id") @db.Uuid
  actorUserId       String           @map("actor_user_id") @db.Uuid
  entityType        ImportEntityType @map("entity_type")
  status            ImportJobStatus  @default(uploaded)

  // Set only for entityType = opening_stock (the warehouse every row's
  // quantity is applied to - chosen once for the whole job, never read from
  // a spreadsheet column, since it must pass the same branch-scope check as
  // every other inventory write).
  targetWarehouseId String? @map("target_warehouse_id") @db.Uuid

  fileKey          String @map("file_key")
  // Sanitized (path separators/control characters stripped) for display
  // only - never used to construct a filesystem path. See StorageService.
  originalFilename String @map("original_filename")
  fileSizeBytes    Int    @map("file_size_bytes")

  detectedColumns Json? @map("detected_columns")
  columnMapping   Json? @map("column_mapping")

  totalRows        Int?    @map("total_rows")
  validRows        Int?    @map("valid_rows")
  errorRows        Int?    @map("error_rows")
  importedRows     Int?    @map("imported_rows")
  // Capped list of {row, field, message} - see IMPORT_MAX_STORED_ERRORS.
  // Never the row's full raw data, just the specific offending value(s).
  validationErrors Json?   @map("validation_errors")
  failureReason    String? @map("failure_reason")

  // Idempotency, same pattern as Sale/Purchase/Expense.clientReferenceId.
  clientReferenceId String? @map("client_reference_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  validatedAt DateTime? @map("validated_at")
  importedAt  DateTime? @map("imported_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, clientReferenceId])
  @@index([companyId, status])
  @@index([companyId, entityType, createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Milestone 8: SaaS / Subscription & Billing
// ---------------------------------------------------------------------------
//
// Plan: global catalog table, NOT tenant data (no company_id) - same
// pattern as Permission/IntegrationProvider (see the RLS migration's own
// comment on those two tables): every tenant is allowed to read the plan
// catalog, so no RLS policy is needed here. `features` is a JSON map of
// FEATURE_KEYS (backend/src/modules/subscriptions/constants/feature-keys.ts)
// -> boolean, the single centralized source a plan's entitlements are read
// from (docs/DOMAIN_MODEL.md "SaaS / Subscription"). `priceMonthlySar` is
// placeholder/demo pricing only - see docs/DEMO.md and the Milestone 8
// final report for why real commercial pricing was never invented here.
model Plan {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  trialEligible   Boolean  @default(true) @map("trial_eligible")
  // Phase 9 ("Control Center must manage trial period"): length of the
  // free trial a company gets when registering on this plan - replaces
  // the previously-hardcoded TRIAL_PERIOD_DAYS=14 constant, which is now
  // only this column's default for every pre-existing plan (see
  // SubscriptionService.createInitialSubscription).
  trialDays       Int      @default(14) @map("trial_days")
  priceMonthlySar Decimal? @map("price_monthly_sar") @db.Decimal(10, 2)
  // Website phase: optional annual price alongside the existing monthly
  // one - null means "annual billing not offered for this plan", not
  // "free". billingInterval stays the DEFAULT interval shown/selected,
  // unchanged in meaning from before this column existed.
  priceAnnualSar  Decimal? @map("price_annual_sar") @db.Decimal(10, 2)
  billingInterval String   @default("monthly") @map("billing_interval")
  // null = unlimited for that resource - see SubscriptionService.assertWithinLimit.
  maxUsers        Int?     @map("max_users")
  maxBranches     Int?     @map("max_branches")
  maxMonthlySales Int?     @map("max_monthly_sales")
  // Phase 13 ("tiered plans with per-role account limits"): maxUsers above
  // stays as a legacy total-membership safety net (kept for the
  // pre-Phase-13 starter/professional demo plans); these four are the real
  // per-role/resource limits the tiered plans (basic/standard/premium/
  // enterprise) actually enforce - see SubscriptionService.resourceUsage.
  // Cashier/Accountant/Manager map to the exact same-named system roles
  // seeded in iam/constants/default-roles.ts - not new roles.
  maxCashiers     Int?     @map("max_cashiers")
  maxAccountants  Int?     @map("max_accountants")
  maxManagers     Int?     @map("max_managers")
  maxWarehouses   Int?     @map("max_warehouses")
  features        Json
  // Website phase ("Packages/Commercial model"): which product(s) this
  // plan/package grants - a JSON array of ProductKey values ("qeedha_b" |
  // "qeedha"), e.g. ["qeedha_b"], ["qeedha"], or ["qeedha_b","qeedha"] for
  // a combined package. Every plan seeded before this phase defaults to
  // ["qeedha_b"] (see migration) - qeedha B is the only product that
  // actually exists in this codebase; "qeedha" entries are prepared
  // product-entitlement state only, not a working integration (the qeedha
  // financing platform is a separate project/database - see
  // docs/WEBSITE.md "qeedha integration boundary").
  products        Json     @default("[\"qeedha_b\"]")
  isRecommended   Boolean  @default(false) @map("is_recommended")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  trialing
  active
  expired
  suspended
  cancelled
}

// One row per Company (1:1 - "Company must be linked to its active
// subscription", docs/DOMAIN_MODEL.md "SaaS / Subscription"). Tenant-scoped
// (company_id) -> RLS required, unlike Plan.
//
// `status` is the last EXPLICITLY set status (via SubscriptionService, e.g.
// registration creating `trialing`, or a future Control Center transition).
// The effective status used for enforcement additionally accounts for
// `trialEndsAt` having passed - see SubscriptionService.getEffectiveStatus.
// When a request first observes an expired trial, SubscriptionService
// persists status='expired' at that moment (lazy transition, audit-logged)
// rather than requiring a background job, since this codebase has no job
// scheduler - see docs/DOMAIN_MODEL.md "SaaS / Subscription" "Why no cron".
model Subscription {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String             @unique @map("company_id") @db.Uuid
  planId              String             @map("plan_id") @db.Uuid
  status              SubscriptionStatus @default(trialing)
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodStart  DateTime?          @map("current_period_start")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  cancelledAt         DateTime?          @map("cancelled_at")
  // Phase 13 ("لوحة تحكمي، أخصص أي باقة"): per-company overrides of the
  // plan's resource limits - null means "use the plan's value", a set
  // value (including 0) wins over the plan regardless of which plan this
  // company is on. This is how a platform admin grants one company an
  // add-on (e.g. "إضافة حساب محاسب" = accountantsOverride: planValue+1)
  // or fully customizes a company on the "enterprise" plan (whose own
  // limits are all null/unlimited by design - see default-plans.ts) without
  // creating a one-off Plan row per customer. See
  // SubscriptionService.resourceUsage for how these combine with the plan.
  usersOverride       Int?               @map("users_override")
  branchesOverride    Int?               @map("branches_override")
  warehousesOverride  Int?               @map("warehouses_override")
  cashiersOverride    Int?               @map("cashiers_override")
  accountantsOverride Int?               @map("accountants_override")
  managersOverride    Int?               @map("managers_override")
  // Same override pattern for the plan's `products` array - lets a single
  // company get the قيّدها (Qeedha/installment) add-on without changing
  // its plan. null = use the plan's products list unchanged.
  productsOverride    Json?              @map("products_override")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Website / SaaS entry platform (not a Milestone - explicitly requested
// feature; see docs/WEBSITE.md for the full design). Global catalog data,
// same "every tenant/visitor may read this, no RLS needed" reasoning as
// Plan above - Market/Affiliate/JoinApplication are platform-level, not
// tenant-owned.
// ---------------------------------------------------------------------------

// Country/market the Control Center can add/activate without a code
// deploy (Website phase spec "Language and country"). `code` is a plain
// ISO 3166-1 alpha-2 string, not an enum, so adding a market is a data
// change only. Company.countryCode is NOT a foreign key to this table
// (see that field's comment) - a company keeps its registered country
// even if the market row is later deactivated.
model Market {
  code               String   @id
  nameAr             String   @map("name_ar")
  nameEn             String   @map("name_en")
  currency           String
  // JSON array of supported language codes for this market, e.g. ["ar","en"].
  supportedLanguages Json     @default("[\"ar\",\"en\"]") @map("supported_languages")
  isActive           Boolean  @default(true) @map("is_active")
  displayOrder       Int      @default(0) @map("display_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("markets")
}

enum AffiliateStatus {
  active
  disabled
}

// A person/organization registered via the public "/site/affiliate" page
// to earn commission for merchants they refer. Deliberately NOT a
// PlatformAdmin or a User/Membership - a third distinct identity kind,
// same reasoning as PlatformAdmin's own doc comment: different trust
// level and lifecycle from either a tenant Membership or a platform
// operator. No login/session exists for affiliates yet (read-only
// self-service dashboard is a documented follow-up, see
// docs/WEBSITE.md "Known gaps") - only the Control Center can view
// affiliate/referral/commission data in this phase.
model Affiliate {
  id                String          @id @default(uuid()) @db.Uuid
  fullName          String          @map("full_name")
  email             String          @unique
  mobile            String?
  // Short, URL-safe, unique code used as `?ref=<code>` - see AuthService
  // referral attribution in createCompanyWithOwner.
  code              String          @unique
  // Percentage (0-100) of the referred company's plan price awarded as
  // commission - Control Center configurable per affiliate (spec:
  // "Commission rules should be configurable from the Control Center").
  commissionPercent Decimal         @default(10) @map("commission_percent") @db.Decimal(5, 2)
  // Phase 9 ("Affiliate Dashboard" - self-service login). Nullable so
  // affiliates registered before this phase (no password collected at the
  // time) don't break the migration; AffiliatesService.login rejects a
  // null hash with the same generic invalid-credentials message as a
  // wrong password, never a distinct "no password set" error (would leak
  // account existence/state).
  passwordHash      String?         @map("password_hash")
  status            AffiliateStatus @default(active)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  referrals AffiliateReferral[]

  @@map("affiliates")
}

// One row per referred Company (first-touch attribution: a company is
// attributed to whichever affiliate code was present at registration
// time, and never re-attributed afterward - see AuthService). companyId
// is unique for exactly this reason. Deliberately NOT tenant-scoped/RLS
// (this is platform-level attribution data the merchant's own tenant
// never reads) - only Company.id is stored, no other tenant data.
model AffiliateReferral {
  id          String   @id @default(uuid()) @db.Uuid
  affiliateId String   @map("affiliate_id") @db.Uuid
  companyId   String   @unique @map("company_id") @db.Uuid
  code        String
  createdAt   DateTime @default(now()) @map("created_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  commission Commission?

  @@index([affiliateId])
  @@map("affiliate_referrals")
}

enum CommissionStatus {
  pending
  approved
  paid
}

// Computed electronically, once, the first time a referred company's
// subscription transitions to `active` (paid) - see
// SubscriptionService.setStatus. Never created/edited with a fabricated
// amount (Website phase spec: "Do not implement fake/manual commission
// values") - `amountSar` is always `referral.affiliate.commissionPercent`
// applied to the plan price in effect at that moment, captured once so a
// later price/percent change never retroactively changes a
// already-computed commission.
model Commission {
  id                  String           @id @default(uuid()) @db.Uuid
  affiliateReferralId String           @unique @map("affiliate_referral_id") @db.Uuid
  amountSar           Decimal          @map("amount_sar") @db.Decimal(10, 2)
  status              CommissionStatus @default(pending)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  affiliateReferral AffiliateReferral @relation(fields: [affiliateReferralId], references: [id], onDelete: Cascade)

  @@map("commissions")
}

enum JoinApplicationStatus {
  new
  reviewed
  accepted
  rejected
}

// "Join Us" / careers / partner applications (Website phase spec). No
// applicant login/session - this is a one-way public submission, reviewed
// only from the Control Center. `cvFileKey` reuses the existing
// StorageService (same key/buffer abstraction Excel import already uses)
// - see StorageService.buildJoinApplicationFileKey.
model JoinApplication {
  id        String                @id @default(uuid()) @db.Uuid
  fullName  String                @map("full_name")
  email     String
  mobile    String?
  // Free-text role label (spec lists examples: Developer, Designer,
  // Marketing, Sales, Support, Consultant, Partner, Other) - not an enum,
  // since the Control Center should never need a deploy to accept a new
  // role label.
  role      String
  message   String?
  cvFileKey String?               @map("cv_file_key")
  status    JoinApplicationStatus @default(new)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@map("join_applications")
}
