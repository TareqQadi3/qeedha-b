# Used by root docker-compose.yml only (Demo/Staging full-stack setup) -
# copy to .env at the repo root and fill in real values. This is separate
# from backend/.env and frontend/.env.local, which each app reads directly -
# see docs/DEPLOYMENT.md for how all three fit together.

POSTGRES_PASSWORD="change-me-to-a-real-password"

# Public URL of the deployed backend API, baked into the frontend build at
# Docker build time (Vite inlines env vars - this cannot be changed after
# the frontend image is built without rebuilding it).
VITE_API_BASE_URL="http://localhost:3000/api/v1"
